{
  "manifest_version": 3,
  "name": "TruthCheck - AI Misinformation Detection",
  "version": "1.0.0",
  "description": "Detect REAL vs FAKE text, images, and videos using AI models.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthCheck",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_popup": "popup.html", "default_title": "TruthCheck" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }]
}
